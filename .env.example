# Dennis Landwehr Website – Umgebungsvariablen
# Echte Werte: lokal in .env (wird nie committet), live in Vercel → Settings → Environment Variables.
# Herkunft: Tina Cloud (app.tina.io) → Projekt → Overview / Tokens. Details: docs/environments.md

# Client-ID des Tina-Cloud-Projekts – öffentlich unbedenklich
# Local: optional · Preview: ja · Production: ja
NEXT_PUBLIC_TINA_CLIENT_ID=

# Read-Only-Token aus Tina Cloud – GEHEIM, nie ins Git
# Local: optional · Preview: ja · Production: ja
TINA_TOKEN=

# Git-Branch, aus dem Tina Inhalte liest
# Local: leer · Preview: leer (Vercel setzt den Branch automatisch) · Production: main
NEXT_PUBLIC_TINA_BRANCH=main
