# =====================================================================
# Gemeinsame Basis aller Agentur-Projekte (Stand: Stufe 1, 09/2026)
# =====================================================================

# Abhängigkeiten
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js / Build-Ausgaben
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# Tests
/coverage

# Umgebungsvariablen – NIE committen. Nur die Vorlage .env.example gehört ins Git.
.env
.env.*
!.env.example

# Hosting-Verknüpfungen (lokal, enthalten Projekt-IDs)
.vercel

# Lokale Claude-Code-Einstellungen (persönliche Freigaben)
.claude/settings.local.json

# Zertifikate / Schlüssel
*.pem
*.key

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Betriebssystem / Editor
.DS_Store
Thumbs.db
*.icloud
.vscode/
.idea/

# =====================================================================
# Projektspezifisch: TinaCMS
# =====================================================================
/tina/__generated__/db
/tina/tina-lock.json.bak
# Der Editor unter /admin wird beim Build erzeugt
public/admin
